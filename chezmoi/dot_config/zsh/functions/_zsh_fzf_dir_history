local -A seen
local -a dirs
local dir
for dir in "$PWD" "${dirstack[@]}"; do
  [[ -d "$dir" && -z ${seen[$dir]} ]] || continue
  dirs+=("$dir")
  seen[$dir]=1
done
(( $#dirs )) || return
dir=$(printf '%s\0' "${dirs[@]}" | command fzf --read0 --no-multi --no-sort --exact --no-preview --height=40% --layout=reverse) || return
builtin cd -q -- "$dir" && zle reset-prompt
