autoload -Uz compinit
() {
  local dump="$XDG_CACHE_HOME/zsh/zcompdump-$ZSH_VERSION"
  local dir rebuild
  [[ -s "$dump" ]] || rebuild=1
  if [[ -z "$rebuild" ]]; then
    for dir in $fpath; do
      [[ -d "$dir" && "$dir" -nt "$dump" ]] || continue
      rebuild=1
      break
    done
  fi
  if [[ -n "$rebuild" ]]; then
    compinit -d "$dump"
  else
    compinit -C -d "$dump"
  fi
  if [[ -s "$dump" && ( ! -s "$dump.zwc" || "$dump" -nt "$dump.zwc" ) ]]; then
    zcompile -R "$dump"
  fi
}

if [[ -z "${ZSH_SCRIPT+X}${ZSH_EXECUTION_STRING+X}" ]]; then
  if (( ! $+commands[fzf] )); then
    print -u2 'zsh: fzf is missing; run `mise install`'
    return 1
  fi

  _fzf_init="$XDG_CACHE_HOME/zsh/fzf.zsh"
  if [[ ! -s "$_fzf_init" || "$commands[fzf]" -nt "$_fzf_init" ]]; then
    command fzf --zsh >| "$_fzf_init" || return
    zcompile -R "$_fzf_init"
  fi
  FZF_CTRL_T_COMMAND=
  FZF_ALT_C_COMMAND=
  FZF_CTRL_R_OPTS='--exact --no-multi --no-preview'
  source "$_fzf_init" || return
  unset _fzf_init FZF_CTRL_T_COMMAND FZF_ALT_C_COMMAND FZF_CTRL_R_OPTS
  bindkey '^I' expand-or-complete
fi

