# vim: set ft=zsh
# shellcheck disable=SC1000-SC9999
#
# Personal Zsh configuration file. It is strongly recommended to keep all
# shell customization and configuration (including exported environment
# variables such as PATH) in this file or in files source by it.
#
# Zsh plugins are installed from pinned upstream revisions by chezmoi.
# Profile loading the shell using `ZPROF=1 zsh -i`
[ -z "$ZPROF" ] || zmodload zsh/zprof

# Enable Powerlevel10k instant prompt. This must stay near the top of the file.
if [[ -z "${ZSH_SCRIPT+X}${ZSH_EXECUTION_STRING+X}" && -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Store stuff in ~/.config and ~/.cache when we can.
# https://wiki.archlinux.org/title/XDG_Base_Directory
# https://www.reddit.com/r/zsh/comments/fvtr19/no_more_dotfile_clutter_in_my_home/
[ -z "$XDG_CONFIG_HOME" ] && export XDG_CONFIG_HOME="${HOME}/.config"
[ -z "$XDG_CACHE_HOME" ] && export XDG_CACHE_HOME="${HOME}/.cache"
[ -z "$XDG_DATA_HOME" ] && export XDG_DATA_HOME="${HOME}/.local/share"
[ -z "$XDG_RUNTIME_DIR" ] && export XDG_RUNTIME_DIR="${HOME}/.tmp"
[ -z "$XDG_STATE_HOME" ] && export XDG_STATE_HOME="${HOME}/.local/state"

## create directories if they don't already exist
for _dir in "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME/zsh/completion" "$XDG_DATA_HOME" "$XDG_RUNTIME_DIR" "$XDG_STATE_HOME/zsh"; do
  [[ -d "$_dir" ]] || mkdir -p "$_dir"
done
unset _dir

typeset -g ZSH_PLUGIN_HOME="$XDG_DATA_HOME/zsh/plugins"

# Ensure path arrays do not contain duplicates.
typeset -gU fpath path

# Extend PATH.
path=(
  ~/bin
  ~/.local/share/gem/bin
  /opt/homebrew/opt/postgresql@17/bin
  /opt/homebrew/opt/trash/bin
  /Applications/Tailscale.app/Contents/MacOS
  $path
)

# Extend function path
fpath=(
  $ZDOTDIR/functions
  $ZDOTDIR/completions
  $ZSH_PLUGIN_HOME/zsh-completions/src
  $fpath
)

[[ ! -r "$XDG_CONFIG_HOME/mise/activate.zsh" ]] || source "$XDG_CONFIG_HOME/mise/activate.zsh"

if [[ -z "${ZSH_SCRIPT+X}${ZSH_EXECUTION_STRING+X}" ]]; then
  source "$ZSH_PLUGIN_HOME/powerlevel10k/powerlevel10k.zsh-theme" || return
  typeset -g POWERLEVEL9K_CONFIG_FILE="$ZDOTDIR/.p10k.zsh"
  source "$POWERLEVEL9K_CONFIG_FILE" || return
fi

